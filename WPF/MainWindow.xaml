<Window x:Class="AliceBotSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AliceBot 设置"
        Height="720" Width="960"
        MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="MainTabs" SelectionChanged="OnTabChanged">
        <!-- ===== 连接设置 ===== -->
        <TabItem Header="连接设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                <StackPanel Margin="12">
                    <!-- Websocket -->
                    <Label Content="Websocket 连接地址" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtWebsocketUrl" Grid.Column="0" Margin="0,0,8,0"/>
                        <Button x:Name="BtnConnect" Grid.Column="1" Content="连接" Width="80" Click="OnConnectClick"/>
                        <Button x:Name="BtnDisconnect" Grid.Column="2" Content="断开" Width="80" Click="OnDisconnectClick" Margin="8,0,0,0"/>
                        <Label x:Name="LblConnStatus" Grid.Column="3" Content="○ 未连接" Foreground="{StaticResource TextError}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- TTS -->
                    <Label Content="语音模块" Margin="0,16,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BtnTtsGradio"    Content="Gradio" Width="70" Style="{StaticResource SmallButton}" Click="OnTtsModeClick" Tag="0"/>
                        <Button x:Name="BtnTtsSimpleVits" Content="Simple-Vits" Width="90" Style="{StaticResource SmallButton}" Click="OnTtsModeClick" Tag="1" Margin="4,0,0,0"/>
                        <Button x:Name="BtnTtsNone"       Content="None" Width="70" Style="{StaticResource SmallButton}" Click="OnTtsModeClick" Tag="2" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Label x:Name="LblTtsUrl" Content="API 地址"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTtsUrl" Grid.Column="0" Margin="0,0,8,0"/>
                        <Button Content="TTS 测试" Grid.Column="1" Width="80" Click="OnTtsTestClick"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTtsTestLine" Grid.Column="0" Margin="0,0,8,0" Text="こんにちは、テストです。"/>
                        <Button Content="发送测试" Grid.Column="1" Width="80" Click="OnTtsSendClick"/>
                    </Grid>

                    <!-- Translation -->
                    <Label Content="翻译模块" Margin="0,16,0,4"/>
                    <Label Content="API 地址"/>
                    <TextBox x:Name="TxtTranslationUrl" Margin="0,0,0,6"/>
                    <Label Content="APP ID"/>
                    <TextBox x:Name="TxtTranslationAppId" Margin="0,0,0,6"/>
                    <Label Content="秘钥"/>
                    <PasswordBox x:Name="TxtTranslationKey" Margin="0,0,0,6"/>
                    <Label Content="Salt"/>
                    <TextBox x:Name="TxtTranslationSalt" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== 对话设置 ===== -->
        <TabItem Header="对话设置">
            <StackPanel Margin="20">
                <Label Content="你的身份" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtIdentity" Margin="0,0,0,12"/>
                <Label Content="预设信息" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPreset" Height="300" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="确定" Width="80" Style="{StaticResource PrimaryButton}" Click="OnDialogSettingsSave"/>
                    <Button Content="取消" Width="80" Click="OnDialogSettingsCancel" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- ===== 模型管理 ===== -->
        <TabItem Header="模型管理">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="VRM 模型路径" Grid.Row="0"/>
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtVrmPath" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Content="浏览" Grid.Column="1" Width="70" Click="OnModelBrowseClick"/>
                    <Button Content="加载" Grid.Column="2" Width="70" Click="OnModelLoadClick" Margin="8,0,0,0"/>
                    <Button Content="恢复默认" Grid.Column="3" Width="80" Click="OnModelRestoreClick" Margin="8,0,0,0"/>
                </Grid>

                <Label Content="加载历史" Grid.Row="2"/>
                <ListBox x:Name="LstModelHistory" Grid.Row="3" SelectionChanged="OnModelHistorySelect"/>
            </Grid>
        </TabItem>

        <!-- ===== 动画库 ===== -->
        <TabItem Header="动画库">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                    <Button Content="刷新" Width="70" Click="OnAnimRefreshClick"/>
                    <Button Content="导入" Width="70" Click="OnAnimImportClick" Margin="8,0,0,0"/>
                    <Label Content="搜索:" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBox x:Name="TxtAnimSearch" Width="180"/>
                    <CheckBox x:Name="ChkRootMotion" Content="Allow Root Motion" VerticalAlignment="Center" Margin="16,0,0,0"
                              Checked="OnRootMotionChanged" Unchecked="OnRootMotionChanged"/>
                </StackPanel>

                <ItemsControl x:Name="IcAnimCategories" Grid.Row="1" Margin="0,4,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ListBox x:Name="LstAnimations" Grid.Row="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="预览" Width="60" Style="{StaticResource SmallButton}"
                                        Tag="{Binding Name}" Click="OnAnimPreviewClick"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <!-- ===== 情绪映射 ===== -->
        <TabItem Header="情绪映射">
            <TabControl x:Name="SubTabs" Margin="-2,-5,-2,0">
                <!-- 子TAB 1: 情绪映射 -->
                <TabItem Header="情绪映射">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                            <ColumnDefinition Width="2*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                                <Button Content="恢复默认" Width="80" Click="OnExprRestoreDefaults"/>
                                <Button Content="添加映射" Width="80" Click="OnExprAdd" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="LstExprMappings" Grid.Row="1" SelectionChanged="OnExprMappingSelect">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding EmotionDisplay}" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FacialSummary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ActionSummary}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="编辑" Width="48" Style="{StaticResource SmallButton}" Tag="{Binding Emotion}" Click="OnExprEditClick"/>
                                                <Button Content="删" Width="40" Style="{StaticResource SmallButton}" Tag="{Binding Emotion}" Click="OnExprDeleteClick" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelExprEdit">
                                    <TextBlock Text="选择或添加一个映射进行编辑" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- 子TAB 2: 动作预设 -->
                <TabItem Header="动作预设">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="2*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                                <Button Content="恢复默认" Width="80" Click="OnPresetRestoreDefaults"/>
                                <Button Content="新建" Width="60" Click="OnPresetAdd" Margin="8,0,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="LstPresets" Grid.Row="1" SelectionChanged="OnPresetSelect">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="编辑" Width="48" Style="{StaticResource SmallButton}" Tag="{Binding Name}" Click="OnPresetEditClick"/>
                                                <Button Content="删" Width="40" Style="{StaticResource SmallButton}" Tag="{Binding Name}" Click="OnPresetDeleteClick" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="12" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelPresetEdit">
                                    <TextBlock Text="选择一个预设进行编辑" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </TabItem>

        <!-- ===== 对话记录 ===== -->
        <TabItem Header="对话记录">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="对话记录" Grid.Row="0"/>
                <TextBox x:Name="TxtHistory" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
                    <Button Content="清空" Width="80" Style="{StaticResource DangerButton}" Click="OnHistoryClearClick"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
